# RECALLED — Frontend Environment Configuration
# Copy this file to .env or .env.local for local overrides

# Backend API proxy URL (defaults to FastAPI server on port 8001)
VITE_BACKEND_URL=http://127.0.0.1:8001

# AI Studio / Application Host URL
APP_URL=http://localhost:3000

# Optional Gemini API Key (for future direct multimodal features)
GEMINI_API_KEY=
