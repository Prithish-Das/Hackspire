# RECALLED — Backend Environment Configuration
# Copy this file to .env in backend/ for local development

# Database connection URL (defaults to local SQLite database in backend/recalled.db)
DATABASE_URL=sqlite:///./recalled.db

# Allowed CORS origins for the frontend application (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Host and Port configuration
HOST=0.0.0.0
PORT=8001

# ElevenLabs Text-to-Speech (Optional: app falls back gracefully to Web Speech API if omitted)
# Server-side only: never exposed to browser, logs, or API responses
ELEVENLABS_API_KEY=curl -H "xi-api-key: sk_6a04c904235da24f5bf4e82a22cd4f5b3ab5c70d3f321032" https://api.elevenlabs.io/v1/models
# Voice ID for calm, warm companion (defaults to Rachel: 21m00Tcm4TlvDq8ikWAM)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Optional male voice ID (defaults to Adam: pNInz6obpgDQGcFmaJgB)
ELEVENLABS_MALE_VOICE_ID=pNInz6obpgDQGcFmaJgB
# Directory for hashed audio caching on disk (safe SHA-256 filenames, no PII stored)
TTS_CACHE_DIR=./audio_cache
